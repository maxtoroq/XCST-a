<module version='1.0' language='C#'
   xmlns='http://maxtoroq.github.io/XCST'
   xmlns:code='https://maxtoroq.github.io/XCST/code'
   xmlns:src='https://maxtoroq.github.io/XCST/compiled'>

   <import-namespace ns='System.Linq'/>
   <import-namespace ns='System.Xml.Linq'/>

   <template name='src:package-attribute-extra' visibility='public'>
      <param name='el' as='XElement' required='yes'/>
      <param name='xcsta_is_page' as='bool' tunnel='yes'/>

      <variable name='genAttr' value='this.AnnotateVirtualPath
         &amp;&amp; xcsta_is_page
         &amp;&amp; this.ApplicationUri != null'/>

      <if test='genAttr
            &amp;&amp; PagePath(el) is { } pagePath'>
         <code:attribute>
            <code:type-reference name='PageVirtualPath' namespace='Xcst.Web'/>
            <code:arguments>
               <code:string>
                  <value-of value='pagePath'/>
               </code:string>
            </code:arguments>
         </code:attribute>
      </if>
   </template>

   <template name='src:infrastructure-extra' visibility='public'>
      <param name='el' as='XElement' required='yes'/>
      <param name='principalModule' as='bool' required='yes'/>
      <param name='modules' as='XElement[]' tunnel='yes'/>
      <param name='xcsta_is_page' as='bool' tunnel='yes'/>

      <variable name='modulePos' value='System.Array.IndexOf(modules, el)'/>
      <variable name='followingModules' value='modules.Skip(modulePos + 1).ToArray()'/>
      <variable name='modelTypeName' value='a + "model-type"' as='XName'/>

      <if test='el.Attribute(modelTypeName) is { } modelTypeAttr
            &amp;&amp; followingModules.All(p => p.Attribute(modelTypeName) is null)'>
         <call-template name='typed-model-props'>
            <with-param name='el' value='el'/>
            <with-param name='modelTypeAttr' value='modelTypeAttr'/>
         </call-template>
      </if>

      <variable name='genLinkTo' value='this.GenerateLinkTo
         &amp;&amp; xcsta_is_page
         &amp;&amp; this.ApplicationUri != null
         &amp;&amp; principalModule'/>

      <if test='genLinkTo
            &amp;&amp; PagePath(el) is { } pagePath'>
         <call-template name='link-to'>
            <with-param name='pagePath' value='pagePath'/>
         </call-template>
      </if>
   </template>

   <template name='typed-model-props'>
      <param name='el' as='XElement' required='yes'/>
      <param name='modelTypeAttr' as='XAttribute' required='yes'/>

      <variable name='modelTypeRef'>
         <code:type-reference name='{xcst_type(modelTypeAttr)}'/>
      </variable>

      <variable name='typedHtmlHelperRef'>
         <code:type-reference name='HtmlHelper' namespace='Xcst.Web.Mvc'>
            <code:type-arguments>
               <copy-of value='modelTypeRef'/>
            </code:type-arguments>
         </code:type-reference>
      </variable>

      <code:property name='DeclaredModelType' visibility='protected' extensibility='override'>
         <code:type-reference name='Type' namespace='System'/>
         <code:getter>
            <code:block>
               <code:return>
                  <code:typeof>
                     <copy-of value='modelTypeRef'/>
                  </code:typeof>
               </code:return>
            </code:block>
         </code:getter>
      </code:property>

      <code:property name='Model' visibility='public' new='true'>
         <copy-of value='modelTypeRef'/>
         <code:attributes>
            <code:attribute>
               <code:type-reference name='MaybeNull' namespace='System.Diagnostics.CodeAnalysis'/>
            </code:attribute>
         </code:attributes>
         <code:getter>
            <code:block>
               <code:disable-warning codes='CS8605'/>
               <code:return>
                  <code:cast>
                     <copy-of value='modelTypeRef'/>
                     <code:property-reference name='Model'>
                        <code:base-reference/>
                     </code:property-reference>
                  </code:cast>
               </code:return>
               <code:restore-warning codes='CS8605'/>
            </code:block>
         </code:getter>
         <code:setter>
            <code:block>
               <code:assign>
                  <code:property-reference name='Model'>
                     <code:base-reference/>
                  </code:property-reference>
                  <code:setter-value/>
               </code:assign>
            </code:block>
         </code:setter>
      </code:property>

      <code:property name='Html' visibility='public' new='true'>
         <copy-of value='typedHtmlHelperRef'/>
         <code:getter>
            <code:block>
               <code:return>
                  <code:cast>
                     <copy-of value='typedHtmlHelperRef'/>
                     <code:property-reference name='Html'>
                        <code:base-reference/>
                     </code:property-reference>
                  </code:cast>
               </code:return>
            </code:block>
         </code:getter>
      </code:property>

      <code:method name='CreateHtmlHelper' visibility='protected' extensibility='override'>
         <code:type-reference name='HtmlHelper' namespace='Xcst.Web.Mvc'/>
         <code:parameters>
            <code:parameter name='viewContext'>
               <code:type-reference name='ViewContext' namespace='Xcst.Web.Mvc'/>
            </code:parameter>
            <code:parameter name='container'>
               <code:type-reference name='IViewDataContainer' namespace='Xcst.Web.Mvc'/>
            </code:parameter>
            <code:parameter name='metadataProvider'>
               <code:type-reference name='IModelMetadataProvider' namespace='Microsoft.AspNetCore.Mvc.ModelBinding'/>
            </code:parameter>
         </code:parameters>
         <code:block>
            <code:return>
               <code:new-object>
                  <copy-of value='typedHtmlHelperRef'/>
                  <code:arguments>
                     <code:variable-reference name='viewContext'/>
                     <code:variable-reference name='container'/>
                     <code:variable-reference name='metadataProvider'/>
                  </code:arguments>
               </code:new-object>
            </code:return>
         </code:block>
      </code:method>
   </template>

   <template name='link-to'>
      <param name='pagePath' as='string' required='yes'/>

      <variable name='defaultPagePath' value='DefaultPagePath(pagePath)'/>

      <variable name='pathPartsRef'>
         <code:variable-reference name='pathParts'/>
      </variable>

      <code:method name='LinkTo' extensibility='static' visibility='public'>
         <code:type-reference name='String' namespace='System'/>
         <code:parameters>
            <code:parameter name='{pathPartsRef.Attribute("name")!.Value}' params='true'>
               <code:type-reference array-dimensions='1' nullable='true'>
                  <copy-of value='src_nullable_object_type'/>
               </code:type-reference>
            </code:parameter>
         </code:parameters>
         <code:block>
            <code:return>
               <code:method-call>
                  <attribute name='name'>
                     <text>LinkTo</text>
                     <if test='defaultPagePath != null'>Default</if>
                  </attribute>
                  <code:type-reference name='UrlHelper' namespace='Xcst.Web'/>
                  <code:arguments>
                     <code:string>
                        <value-of value='"/" + pagePath'/>
                     </code:string>
                     <if test='defaultPagePath != null'>
                        <code:string>
                           <value-of value='"/" + defaultPagePath'/>
                        </code:string>
                     </if>
                     <copy-of value='pathPartsRef'/>
                  </code:arguments>
               </code:method-call>
            </code:return>
         </code:block>
      </code:method>
   </template>

</module>
