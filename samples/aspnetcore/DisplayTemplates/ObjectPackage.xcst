<?xml version="1.0" encoding="utf-8"?>
<c:package version='1.0' language='C#' inherits='Xcst.Web.Mvc.XcstViewPage'
   xmlns:c='http://maxtoroq.github.io/XCST'
   xmlns:a='http://maxtoroq.github.io/XCST/application'
   extension-element-prefixes='a'>

   <c:param name='labelColumnClass'>col-md-3</c:param>
   <c:param name='fieldColumnClass'>col-md-9</c:param>

   <c:template name='c:initial-template' visibility='public'>

      <c:if test='Model is null || ViewContext.TemplateDepth > 1'>
         <a:display-text/>
         <c:return/>
      </c:if>

      <c:variable name='filteredProperties' value='Html.DisplayProperties()'/>

      <c:for-each name='propertyExplorer' in='filteredProperties'>

         <c:variable name='propertyMeta' value='propertyExplorer.Metadata'/>
         <c:variable name='propertyName' value='propertyMeta.PropertyName'/>

         <c:if test='propertyMeta.HideSurroundingHtml'>
            <a:display name='{propertyName}'/>
            <c:continue/>
         </c:if>

         <c:if test='Html.MemberTemplate(propertyExplorer) is { } memberTemplate'>
            <c:invoke-delegate delegate='memberTemplate'/>
            <c:continue/>
         </c:if>

         <div class='row mb-3'>
            <a:label name='{propertyName}' class='col-form-label {this.labelColumnClass}'/>
            <div class='{this.fieldColumnClass}'>
               <div class='form-control-plaintext'>
                  <a:display name='{propertyName}'/>
               </div>
            </div>
         </div>
      </c:for-each>
   </c:template>

</c:package>
