<?xml version="1.0" encoding="utf-8" ?>
<c:module version='1.0' language='C#'
   xmlns:c='http://maxtoroq.github.io/XCST'
   xmlns:a='http://maxtoroq.github.io/XCST/application'
   extension-element-prefixes='a'>

   <c:import-namespace ns='Microsoft.Extensions.DependencyInjection'/>
   <c:import-namespace ns='Microsoft.Extensions.Options'/>

   <c:type name='MyModel'>
      <c:member name='a' as='string' required='yes'/>
      <c:member name='b' as='string?' required='no'/>
   </c:type>

   <c:template name='c:initial-template'>
      <c:variable name='options' value='HttpContext.RequestServices
         .GetRequiredService&lt;IOptions&lt;Xcst.Web.Mvc.ViewOptions>>()
         .Value'/>
      <c:set ref='options.LabelCssClass' value='req => (req) ? "req" : null'/>
      <a:model type='MyModel'>
         <div>
            <a:label for='a'/>
            <a:label name='a' class='my-class'/>
            <a:label for='b' class='my-class'/>
            <a:label name='b'/>
         </div>
      </a:model>
   </c:template>

   <c:template name='expected'>
      <div>
         <label for='a' class='req'>a</label>
         <label for='a' class='my-class req'>a</label>
         <label for='b' class='my-class'>b</label>
         <label for='b'>b</label>
      </div>
   </c:template>

</c:module>
