<?xml version="1.0" encoding="utf-8" ?>
<c:module version='1.0' language='C#'
   xmlns:c='http://maxtoroq.github.io/XCST'
   xmlns:a='http://maxtoroq.github.io/XCST/application'
   extension-element-prefixes='a'>

   <c:type name='Foo'>
      <c:member name='p' as='string'/>
   </c:type>

   <c:template name='c:initial-template'>
      <c:set ref='ViewContext.ClientValidationEnabled' value='false'/>
      <div>
         <a:model value='new Foo { p = "property" }' helper-name='htm'>
            <!--
            <c:set ref='htm.ViewData["p"]'>foo</c:set>
            -->

            <!-- different value -->
            <a:radio class='a' for='p' value='"foo"'/>
            <a:radio class='b' name='p' value='"foo"'/>
         </a:model>
         <a:model value='new Foo { p = "property" }'>

            <!-- same value -->
            <a:radio class='c' for='p' value='"property"'/>
            <a:radio class='d' name='p' value='"property"'/>

            <!-- explicit checked -->
            <a:radio class='e' name='p' value='"foo"' checked='yes'/>
            <a:radio class='f' name='p' value='"property"' checked='no'/>
         </a:model>
         <a:model value='"model"' field-prefix='p' helper-name='htm'>
            <!--
            <c:set ref='htm.ViewData[""]'>foo</c:set>
            <c:set ref='htm.ViewData["p"]'>foo</c:set>
            -->

            <!-- different value -->
            <a:radio class='j' value='"foo"'/>
         </a:model>
         <a:model value='"model"' field-prefix='p'>

            <!-- same value -->
            <a:radio class='k' value='"model"'/>

            <!-- explicit checked -->
            <a:radio class='l' value='"foo"' checked='yes'/>
            <a:radio class='m' value='"model"' checked='no'/>
         </a:model>
         <a:model value='new Foo { p = "property" }' field-prefix='x'>
            <a:radio class='p' for='p' value='"property"'/>
            <a:radio class='q' name='p' value='"property"'/>
         </a:model>
         <!--
         <c:set ref='ViewData["p"]'>foo</c:set>
         -->
         <a:radio class='r' name='p' value='"foo"'/>
      </div>
   </c:template>

   <c:template name='expected'>
      <div>
         <input class='a' type='radio' id='p' name='p' value='foo'/>
         <input class='b' type='radio' id='p' name='p' value='foo'/>
         <input class='c' type='radio' id='p' name='p' value='property' checked='checked'/>
         <input class='d' type='radio' id='p' name='p' value='property' checked='checked'/>
         <input class='e' type='radio' id='p' name='p' value='foo' checked='checked'/>
         <input class='f' type='radio' id='p' name='p' value='property'/>
         <input class='j' type='radio' id='p' name='p' value='foo'/>
         <input class='k' type='radio' id='p' name='p' value='model' checked='checked'/>
         <input class='l' type='radio' id='p' name='p' value='foo' checked='checked'/>
         <input class='m' type='radio' id='p' name='p' value='model'/>
         <input class='p' type='radio' id='x_p' name='x.p' value='property' checked='checked'/>
         <input class='q' type='radio' id='x_p' name='x.p' value='property' checked='checked'/>
         <input class='r' type='radio' id='p' name='p' value='foo'/>
      </div>
   </c:template>

</c:module>