<?xml version="1.0" encoding="utf-8" ?>
<c:module version='1.0' language='C#' a:model-type='InheritViewOptionsModel'
   xmlns:c='http://maxtoroq.github.io/XCST'
   xmlns:a='http://maxtoroq.github.io/XCST/application'
   extension-element-prefixes='a'>

   <c:import-namespace ns='System.Collections.Generic'/>
   <c:import-namespace ns='Xcst.Web.Mvc'/>

   <c:template name='c:initial-template'>
      <c:set ref='ViewContext.ClientValidationEnabled' value='false'/>
      <c:set ref='ViewContext.MembersOptions["color"]' value='
         new SelectListItem[] {
            new() { Text = "red" },
            new() { Text = "blue" }
         }'/>
      <a:editor for='color'/>
   </c:template>

   <c:template name='expected'>
      <select name="color" id="color">
         <option>red</option>
         <option>blue</option>
      </select>
   </c:template>

</c:module>