<?xml version="1.0" encoding="utf-8" ?>
<c:module version='1.0' language='C#'
   xmlns:c='http://maxtoroq.github.io/XCST'
   xmlns:a='http://maxtoroq.github.io/XCST/application'
   extension-element-prefixes='a'>

   <c:import-namespace ns='Microsoft.AspNetCore.Http'/>

   <c:type name='Foo'>
      <c:member name='f' as='IFormFile'/>
      <c:member name='f2' as='IFormFile[]'/>
   </c:type>

   <c:template name='c:initial-template'>
      <c:set ref='ViewContext.ClientValidationEnabled' value='false'/>
      <div>
         <a:model value='new Foo()'>
            <a:editor for='f'/>
            <a:editor for='f2'/>
         </a:model>
      </div>
   </c:template>

   <c:template name='expected'>
      <div>
         <input type='file' id='f' name='f'/>
         <input type='file' id='f2' name='f2' multiple='multiple'/>
      </div>
   </c:template>

</c:module>
