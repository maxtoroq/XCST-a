<?xml version="1.0" encoding="utf-8" ?>
<c:module version='1.0' language='C#'
   xmlns:c='http://maxtoroq.github.io/XCST'
   xmlns:a='http://maxtoroq.github.io/XCST/application'
   extension-element-prefixes='a'>

   <c:import-namespace ns='System'/>

   <c:type name='Foo'>
      <c:member name='Bar' as='DateTimeKind' format='Kind: {0}'/>
   </c:type>

   <c:template name='c:initial-template'>
      <c:set ref='ViewContext.ClientValidationEnabled' value='false'/>
      <a:model type='Foo'>
         <a:editor for='Bar'/>
      </a:model>
   </c:template>

   <c:template name='expected'>
      <select id='Bar' name='Bar'>
         <option value=''/>
         <option value='Unspecified'>Kind: Unspecified</option>
         <option value='Utc'>Kind: Utc</option>
         <option value='Local'>Kind: Local</option>
      </select>
   </c:template>

</c:module>