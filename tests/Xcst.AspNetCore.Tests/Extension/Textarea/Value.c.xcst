<?xml version="1.0" encoding="utf-8" ?>
<c:module version='1.0' language='C#'
   xmlns:c='http://maxtoroq.github.io/XCST'
   xmlns:a='http://maxtoroq.github.io/XCST/application'
   extension-element-prefixes='a'>

   <c:import-namespace ns='System'/>

   <c:type name='Foo'>
      <c:member name='p' as='string'/>
   </c:type>

   <c:template name='c:initial-template'>
      <c:set ref='ViewContext.ClientValidationEnabled' value='false'/>
      <div>
         <a:model value='new Foo()' helper-name='htm'>
            <!--
            <c:set ref='htm.ViewData["p"]'>viewdata</c:set>
            -->
            <a:textarea class='a' name='p'>text</a:textarea>
         </a:model>
         <a:model value='new Foo { p = "property" }' helper-name='htm'>
            <!--
            <c:set ref='htm.ViewData["p"]'>viewdata</c:set>
            -->
            <a:textarea class='b' for='p'/>
            <a:textarea class='c' name='p'/>
            <a:textarea class='d' name='p'>text</a:textarea>
            <a:textarea class='e' name='p' value='"explicit"'/>
            <a:textarea class='f' name='p' value='"explicit"'>text</a:textarea>
         </a:model>
         <a:model value='"model"' field-prefix='p' helper-name='htm'>
            <!--
            <c:set ref='htm.ViewData[""]'>viewdata</c:set>
            <c:set ref='htm.ViewData["p"]'>viewdata</c:set>
            -->
            <a:textarea class='g'/>
            <a:textarea class='h' value='"explicit"'/>
            <a:textarea class='i'>text</a:textarea>
            <a:textarea class='j' value='"explicit"'>text</a:textarea>
         </a:model>
         <a:model value='new Foo { p = "property" }' field-prefix='x'>
            <a:textarea class='k' for='p'/>
            <a:textarea class='l' name='p'/>
         </a:model>
         <!--
         <c:set ref='ViewData["p"]'>viewdata</c:set>
         -->
         <a:textarea class='m' name='p'/>
      </div>
   </c:template>

   <c:template name='expected' expand-text='yes'>
      <div>
         <textarea class='a' id='p' name='p'>text</textarea>
         <textarea class='b' id='p' name='p'>{Environment.NewLine}property</textarea>
         <textarea class='c' id='p' name='p'>{Environment.NewLine}property</textarea>
         <textarea class='d' id='p' name='p'>text{Environment.NewLine}property</textarea>
         <textarea class='e' id='p' name='p'>{Environment.NewLine}explicit</textarea>
         <textarea class='f' id='p' name='p'>text{Environment.NewLine}explicit</textarea>
         <textarea class='g' id='p' name='p'>{Environment.NewLine}model</textarea>
         <textarea class='h' id='p' name='p'>{Environment.NewLine}explicit</textarea>
         <textarea class='i' id='p' name='p'>text{Environment.NewLine}model</textarea>
         <textarea class='j' id='p' name='p'>text{Environment.NewLine}explicit</textarea>
         <textarea class='k' id='x_p' name='x.p'>{Environment.NewLine}property</textarea>
         <textarea class='l' id='x_p' name='x.p'>{Environment.NewLine}property</textarea>
         <textarea class='m' id='p' name='p'/>
      </div>
   </c:template>

</c:module>