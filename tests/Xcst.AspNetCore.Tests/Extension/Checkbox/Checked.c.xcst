<?xml version="1.0" encoding="utf-8" ?>
<c:module version='1.0' language='C#'
   xmlns:c='http://maxtoroq.github.io/XCST'
   xmlns:a='http://maxtoroq.github.io/XCST/application'
   extension-element-prefixes='a'>

   <c:type name='Foo'>
      <c:member name='p' as='bool'/>
   </c:type>

   <c:template name='c:initial-template'>
      <c:set ref='ViewContext.ClientValidationEnabled' value='false'/>
      <div>
         <a:model value='new Foo { p = true }' helper-name='htm'>
            <c:set ref='htm.ViewData["p"]' value='true'/>
            <a:checkbox class='a' for='p'/>
            <a:checkbox class='b' name='p'/>
            <a:checkbox class='c' name='p' checked='false'/>
         </a:model>
         <a:model value='true' field-prefix='p' helper-name='htm'>
            <c:set ref='htm.ViewData[""]' value='true'/>
            <c:set ref='htm.ViewData["p"]' value='true'/>
            <a:checkbox class='e'/>
            <a:checkbox class='f' checked='false'/>
         </a:model>
         <a:model value='new Foo { p = true }' field-prefix='x'>
            <a:checkbox class='h' for='p'/>
            <a:checkbox class='i' name='p'/>
         </a:model>
         <c:set ref='ViewData["p"]' value='true'/>
         <a:checkbox class='j' name='p'/>
      </div>
   </c:template>

   <c:template name='expected'>
      <div>
         <input class='a' type='checkbox' id='p' name='p' value='true' checked='checked'/>
         <input type='hidden' name='p' value='false'/>

         <input class='b' type='checkbox' id='p' name='p' value='true' checked='checked'/>
         <input type='hidden' name='p' value='false'/>

         <input class='c' type='checkbox' id='p' name='p' value='true'/>
         <input type='hidden' name='p' value='false'/>

         <input class='e' type='checkbox' id='p' name='p' value='true' checked='checked'/>
         <input type='hidden' name='p' value='false'/>

         <input class='f' type='checkbox' id='p' name='p' value='true'/>
         <input type='hidden' name='p' value='false'/>

         <input class='h' type='checkbox' id='x_p' name='x.p' value='true' checked='checked'/>
         <input type='hidden' name='x.p' value='false'/>

         <input class='i' type='checkbox' id='x_p' name='x.p' value='true' checked='checked'/>
         <input type='hidden' name='x.p' value='false'/>

         <input class='j' type='checkbox' id='p' name='p' value='true'/>
         <input type='hidden' name='p' value='false'/>
      </div>
   </c:template>

</c:module>