<?xml version="1.0" encoding="utf-8" ?>
<c:module version='1.0' language='C#'
   xmlns:c='http://maxtoroq.github.io/XCST'
   xmlns:a='http://maxtoroq.github.io/XCST/application'
   extension-element-prefixes='a'>

   <c:type name='Foo'>
      <c:member name='p' as='string'/>
   </c:type>

   <c:template name='c:initial-template'>
      <c:set ref='ViewContext.ClientValidationEnabled' value='false'/>
      <div>
         <a:model value='new Foo { p = "property" }'>
            <a:input class='a' for='p'/>
            <a:input class='b' name='p'/>
            <a:input class='c' name='p' value='"explicit"'/>
         </a:model>
         <a:model value='"model"' field-prefix='p'>
            <a:input class='d'/>
            <a:input class='e' value='"explicit"'/>
         </a:model>
         <a:model value='new Foo { p = "property" }' field-prefix='x'>
            <a:input class='f' for='p'/>
            <a:input class='g' name='p'/>
         </a:model>
      </div>
   </c:template>

   <c:template name='expected'>
      <div>
         <input class='a' type='text' id='p' name='p' value='property'/>
         <input class='b' type='text' id='p' name='p' value='property'/>
         <input class='c' type='text' id='p' name='p' value='explicit'/>
         <input class='d' type='text' id='p' name='p' value='model'/>
         <input class='e' type='text' id='p' name='p' value='explicit'/>
         <input class='f' type='text' id='x_p' name='x.p' value='property'/>
         <input class='g' type='text' id='x_p' name='x.p' value='property'/>
      </div>
   </c:template>

</c:module>