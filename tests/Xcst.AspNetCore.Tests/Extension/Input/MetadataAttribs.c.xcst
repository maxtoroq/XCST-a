<?xml version="1.0" encoding="utf-8" ?>
<c:module version='1.0' language='C#'
   xmlns:c='http://maxtoroq.github.io/XCST'
   xmlns:a='http://maxtoroq.github.io/XCST/application'
   extension-element-prefixes='a'>

   <c:type name='Foo'>
      <c:member name='p' as='string' edit-hint='Enter something...'>
         <c:meta type='System.ComponentModel.DataAnnotations.Editable' args='false'/>
      </c:member>
   </c:type>

   <c:template name='c:initial-template'>
      <c:set ref='ViewContext.ClientValidationEnabled' value='false'/>
      <div>
         <a:model value='new Foo()'>
            <a:input for='p'/>
            <a:input name='p'/>
         </a:model>
      </div>
   </c:template>

   <c:template name='expected' expand-text='yes'>
      <div>
         <input type='text' id='p' name='p' value='' placeholder='Enter something...' readonly='readonly'/>
         <input type='text' id='p' name='p' value='' placeholder='Enter something...' readonly='readonly'/>
      </div>
   </c:template>

</c:module>