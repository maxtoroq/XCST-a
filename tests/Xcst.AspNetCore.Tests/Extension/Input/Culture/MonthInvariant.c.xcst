<?xml version="1.0" encoding="utf-8" ?>
<c:module version='1.0' language='C#'
   xmlns:c='http://maxtoroq.github.io/XCST'
   xmlns:a='http://maxtoroq.github.io/XCST/application'
   extension-element-prefixes='a'>

   <c:template name='c:initial-template'>
      <c:set ref='ViewContext.FormMethod' value='Xcst.Web.Mvc.FormMethod.Get'/>
      <div>
         <a:input type='month' name='n1' value='new System.DateTime(1999, 12, 31)'/>
         <a:input type='{"month"}' name='n2' value='new System.DateTime(1999, 12, 31)'/>
      </div>
   </c:template>

   <c:template name='expected'>
      <div>
         <input id='n1' type='month' name='n1' value='1999-12'/>
         <input id='n2' type='month' name='n2' value='1999-12'/>
      </div>
   </c:template>

</c:module>