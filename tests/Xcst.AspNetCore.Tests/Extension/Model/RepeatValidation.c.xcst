<?xml version="1.0" encoding="utf-8" ?>
<c:module version='1.0' language='C#'
   xmlns:c='http://maxtoroq.github.io/XCST'
   xmlns:a='http://maxtoroq.github.io/XCST/application'
   extension-element-prefixes='a'>

   <c:type name='ColorModel'>
      <c:member name='color' as='string' required='yes'/>
   </c:type>

   <c:template name='c:initial-template'>
      <div>
         <a:model type='ColorModel'>
            <a:input for='color'/>
         </a:model>
         <a:model type='ColorModel'>
            <a:input for='color'/>
         </a:model>
      </div>
   </c:template>

   <c:template name='expected'>
      <div>
         <input id='color' type='text' name='color' value='' data-val='true' data-val-required='The color field is required.'/>
         <input id='color' type='text' name='color' value='' data-val='true' data-val-required='The color field is required.'/>
      </div>
   </c:template>

</c:module>