<?xml version="1.0" encoding="utf-8" ?>
<c:module version='1.0' language='C#' xmlns:c='http://maxtoroq.github.io/XCST'>

   <c:import href='_ModelTypeImport.xcst'/>

   <c:template name='c:initial-template'>
      <c:void value='Assert.AreEqual(typeof(string), CompileType(() => this.Model))'/>
      <c:void value='Assert.AreEqual(typeof(Xcst.Web.Mvc.HtmlHelper&lt;string>), CompileType(() => this.Html))'/>
   </c:template>

</c:module>
