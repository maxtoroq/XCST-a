<?xml version="1.0" encoding="utf-8" ?>
<c:module version='1.0' language='C#' a:model-type='int'
   xmlns:c='http://maxtoroq.github.io/XCST'
   xmlns:a='http://maxtoroq.github.io/XCST/application'>

   <c:template name='c:initial-template'>
      <c:void value='Assert.AreEqual(typeof(int), CompileType(() => this.Model))'/>
      <c:void value='Assert.AreEqual(typeof(Xcst.Web.Mvc.HtmlHelper&lt;int>), CompileType(() => this.Html))'/>
   </c:template>

</c:module>
