<?xml version="1.0" encoding="utf-8" ?>
<c:module version='1.0' language='C#'
   xmlns:c='http://maxtoroq.github.io/XCST'
   xmlns:a='http://maxtoroq.github.io/XCST/application'
   extension-element-prefixes='a'>

   <c:type name='ContactModel'>
      <c:member name='first_name' as='string' display-name='First Name'/>
      <c:member name='last_name' as='string'/>
   </c:type>

   <c:template name='c:initial-template'>
      <c:set ref='ViewContext.ClientValidationEnabled' value='false'/>
      <a:model type='ContactModel'>
         <a:fieldset for='first_name'>
            <legend>
               <a:display-name/>
            </legend>
            <a:input/>
         </a:fieldset>
      </a:model>
   </c:template>

   <c:template name='expected'>
      <fieldset>
         <legend>First Name</legend>
         <input id='first_name' type='text' name='first_name' value=''/>
      </fieldset>
   </c:template>

</c:module>