<?xml version="1.0" encoding="utf-8" ?>
<?xcst-test disable-warning="CS0162" ?>
<c:module version='1.0' language='C#'
   xmlns:c='http://maxtoroq.github.io/XCST'
   xmlns:a='http://maxtoroq.github.io/XCST/application'
   extension-element-prefixes='a'>

   <c:import-namespace ns='Xcst.Web.Mvc'/>

   <c:template name='c:initial-template'>
      <div>
         <a:select name='a'>
            <c:attribute name='data-foo'>foo</c:attribute>
            <a:option value='"opt1"'>Option 1</a:option>
            <optgroup label='Option Group 1'>
               <a:option value='"opt2"'>Option 2</a:option>
               <option>Option 3</option>
            </optgroup>
         </a:select>
         <a:select name='b' options='new SelectListItem[] { new() { Value = "v", Text = "t" } }'>
            <c:attribute name='data-foo'>foo</c:attribute>
            <c:return/>
         </a:select>
      </div>
   </c:template>

   <c:template name='expected'>
      <div>
         <select id='a' name='a' data-foo='foo'>
            <option value='opt1'>Option 1</option>
            <optgroup label='Option Group 1'>
               <option value='opt2'>Option 2</option>
               <option>Option 3</option>
            </optgroup>
         </select>
         <select id='b' name='b' data-foo='foo'/>
      </div>
   </c:template>

</c:module>