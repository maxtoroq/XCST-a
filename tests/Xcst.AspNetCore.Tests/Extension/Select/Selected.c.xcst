<?xml version="1.0" encoding="utf-8" ?>
<c:module version='1.0' language='C#'
   xmlns:c='http://maxtoroq.github.io/XCST'
   xmlns:a='http://maxtoroq.github.io/XCST/application'
   extension-element-prefixes='a'>

   <c:import-namespace ns='Xcst.Web.Mvc'/>

   <c:type name='Foo'>
      <c:member name='color' as='string'/>
   </c:type>

   <c:template name='c:initial-template'>
      <c:set ref='ViewContext.ClientValidationEnabled' value='false'/>
      <div>
         <!-- value overrides selected of static option -->
         <a:select class='a' name='color' value='"red"'>
            <a:option>red</a:option>
            <a:option selected='yes'>blue</a:option>
         </a:select>
         <!-- value overrides selected of dynamic option -->
         <a:select class='b' name='color' value='"red"'
            options='new SelectListItem[] { new() { Text = "red" }, new() { Text = "blue", Selected = true } }'/>
         <!-- model selected -->
         <a:model value='"blue"' field-prefix='color' helper-name='htm'>
            <!--
            <c:set ref='htm.ViewData[""]'>red</c:set>
            <c:set ref='htm.ViewData["color"]'>red</c:set>
            -->
            <a:select class='c'>
               <a:option>red</a:option>
               <a:option>blue</a:option>
            </a:select>
         </a:model>
         <a:model value='"blue"' field-prefix='color' helper-name='htm'>
            <!--
            <c:set ref='htm.ViewData[""]'>green</c:set>
            <c:set ref='htm.ViewData["color"]'>green</c:set>
            -->
            <a:select class='d' value='"red"'>
               <a:option>red</a:option>
               <a:option>blue</a:option>
               <a:option>green</a:option>
            </a:select>
         </a:model>
         <a:model value='new Foo { color = "blue" }' helper-name='htm'>
            <!--
            <c:set ref='htm.ViewData["color"]'>red</c:set>
            -->
            <a:select class='e' for='color'>
               <a:option>red</a:option>
               <a:option>blue</a:option>
            </a:select>
            <a:select class='f' name='color'>
               <a:option>red</a:option>
               <a:option>blue</a:option>
            </a:select>
         </a:model>
         <a:model value='new Foo { color = "blue" }' helper-name='htm'>
            <!--
            <c:set ref='htm.ViewData["color"]'>green</c:set>
            -->
            <a:select class='g' name='color' value='"red"'>
               <a:option>red</a:option>
               <a:option>blue</a:option>
               <a:option>green</a:option>
            </a:select>
         </a:model>
         <a:model value='new Foo { color = "blue" }' field-prefix='x'>
            <a:select class='h' for='color'>
               <a:option>red</a:option>
               <a:option>blue</a:option>
            </a:select>
            <a:select class='i' name='color'>
               <a:option>red</a:option>
               <a:option>blue</a:option>
            </a:select>
         </a:model>
         <!--
         <c:set ref='ViewData["color"]'>blue</c:set>
         -->
         <a:select class='j' name='color'>
            <a:option>red</a:option>
            <a:option>blue</a:option>
         </a:select>
      </div>
   </c:template>

   <c:template name='expected'>
      <div>
         <select class="a" name="color" id="color">
            <option selected="selected">red</option>
            <option>blue</option>
         </select>

         <select class="b" name="color" id="color">
            <option selected="selected">red</option>
            <option>blue</option>
         </select>

         <select class="c" name="color" id="color">
            <option>red</option>
            <option selected="selected">blue</option>
         </select>

         <select class="d" name="color" id="color">
            <option selected="selected">red</option>
            <option>blue</option>
            <option>green</option>
         </select>

         <select class="e" name="color" id="color">
            <option>red</option>
            <option selected="selected">blue</option>
         </select>

         <select class="f" name="color" id="color">
            <option>red</option>
            <option selected="selected">blue</option>
         </select>

         <select class="g" name="color" id="color">
            <option selected="selected">red</option>
            <option>blue</option>
            <option>green</option>
         </select>

         <select class="h" name="x.color" id="x_color">
            <option>red</option>
            <option selected="selected">blue</option>
         </select>

         <select class="i" name="x.color" id="x_color">
            <option>red</option>
            <option selected="selected">blue</option>
         </select>

         <select class="j" name="color" id="color">
            <option>red</option>
            <option>blue</option>
         </select>
      </div>
   </c:template>

</c:module>